# Copy this file to .env.local and fill in the values.
# NEVER commit .env.local — it holds secrets.

# Supabase → Project Settings → API Keys
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Secret key: server only. Never prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# Resend: volunteer confirmation emails (server only)
RESEND_API_KEY=

# Google Maps venue search (server only; see docs/SETUP-GUIDE.md)
GOOGLE_MAPS_API_KEY=

# Feedback button: opens a GitHub issue for each message (server only; see docs/SETUP-GUIDE.md)
GITHUB_FEEDBACK_TOKEN=
# GITHUB_FEEDBACK_REPO=cftrreanor/3ds

